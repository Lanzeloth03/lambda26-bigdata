    {
      "id": 17,
      "type": "timeseries",
      "title": "Entrada Kafka vs procesamiento Spark",
      "description": "Correlacion: lo que entra al topic (kafka-exporter) frente a lo que Spark lee y procesa.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"atmos-real\"}[1m]))",
          "legendFormat": "Kafka: mensajes/s (broker)",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
