{
 "uid": "lambda26-u3-integracion",
 "title": "U3 - Integración Aire: batch + streaming + observabilidad",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "tags": [
  "lambda26",
  "u3",
  "aire",
  "integracion"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "MAE del modelo vs persistencia (µg/m³) — última corrida de integración",
   "description": "Menor es mejor. El modelo debe quedar por debajo de la persistencia (compuerta S5).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "lambda26_aire_mae_modelo{job=\"lambda26_aire_int\",instance=\"inferencia\"}",
     "refId": "A",
     "legendFormat": "modelo (GBT)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "lambda26_aire_mae_persistencia{job=\"lambda26_aire_int\",instance=\"inferencia\"}",
     "refId": "B",
     "legendFormat": "persistencia"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Mejora vs persistencia (%)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "lambda26_aire_mejora_pct{job=\"lambda26_aire_int\",instance=\"inferencia\"}",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "green",
        "value": 20
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Horas evaluadas (n_evaluadas)",
   "description": "Ventana fija de 168 h → 143 evaluadas (24 h de historia + 1 sin siguiente).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "lambda26_aire_n_evaluadas{job=\"lambda26_aire_int\",instance=\"inferencia\"}",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
